{
    "name": "msdm/psikotes",
    "type": "project",
    "description": "Aplikasi psikotes msdm (DISC, PAPI Kostick, Kraepelin) dengan Laravel dan SQLite",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

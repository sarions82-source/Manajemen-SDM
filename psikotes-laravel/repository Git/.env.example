APP_NAME=msdm
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Lokasi file database (bawaan: database/database.sqlite)
# DB_DATABASE=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# WAJIB diisi bila dipasang online: ubah APP_ENV=production di atas dan isi SETUP_KEY di bawah.
# Tanpa SETUP_KEY, pembuatan Super Admin pertama ditolak saat APP_ENV=production.
# Kunci pemasangan (opsional di komputer lokal, wajib saat online).
# Jika diisi, kunci ini wajib dimasukkan saat mendaftarkan Super Admin pertama.
SETUP_KEY=

APP_NAME=msdm
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=warning

# Database MySQL (wajib). Buat database kosong bernama sama dengan DB_NAME. Di Wasmer Edge nilai DB_* ini diisi otomatis.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=psikotes
DB_USERNAME=root
DB_PASSWORD=
# Bila koneksi gagal karena TLS, coba DB_SSL=false, atau isi DB_SSL_CA dengan lokasi berkas CA.

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# WAJIB diisi bila dipasang online: ubah APP_ENV=production di atas dan isi SETUP_KEY di bawah.
# Tanpa SETUP_KEY, pembuatan Super Admin pertama ditolak saat APP_ENV=production.
# Kunci pemasangan (opsional di komputer lokal, wajib saat online).
# Jika diisi, kunci ini wajib dimasukkan saat mendaftarkan Super Admin pertama.
SETUP_KEY=
